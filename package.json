{
  "name": "geostyler-legend",
  "version": "5.2.1",
  "description": "A simple legend component for geostyler-stlye.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "prerelease": "npm run build",
    "lint": "eslint . && tsc --noEmit --project tsconfig.json",
    "clean:dist": "rimraf ./dist/*",
    "build": "vite build && tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage"
  },
  "engines": {
    "node": "^22.22.2 || >=24.15"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/geostyler/geostyler-legend.git"
  },
  "author": "geostyler GmbH & Co. KG <info@geostyler.de>",
  "license": "BSD-2-Clause",
  "bugs": {
    "url": "https://github.com/geostyler/geostyler-legend/issues"
  },
  "homepage": "https://github.com/geostyler/geostyler-legend#readme",
  "dependencies": {
    "@types/d3-selection": "^3.0.12",
    "geostyler-openlayers-parser": "^5.8.0",
    "geostyler-style": "^13.1.0"
  },
  "peerDependencies": {
    "d3": ">=6",
    "ol": ">=6"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@terrestris/eslint-config-typescript": "^10.0.0",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-istanbul": "^5.0.5",
    "canvas": "3.2.3",
    "conventional-changelog-conventionalcommits": "^10.4.1",
    "d3": "^7.9.0",
    "eslint": "^9.39.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "extensionless": "^2.0.6",
    "jsdom": "^30.1.3",
    "ol": "^10.11.0",
    "rimraf": "^6.1.3",
    "semantic-release": "^25.0.9",
    "typescript": "~5.9.0",
    "vite": "^8.3.5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.5",
    "vitest-canvas-mock": "^1.2.0"
  },
  "funding": "https://opencollective.com/geostyler",
  "allowScripts": {
    "canvas@3.2.3": true
  }
}
